# Public URL of the deployment. Used for the NFC tag URL and the QR fallback.
# Leave empty locally; the app falls back to the current browser origin.
NEXT_PUBLIC_BASE_URL=

# Optional LLM theme detection. Off by default; deterministic keyword themes are used otherwise.
COMPASS_LLM_ENABLED=false
COMPASS_LLM_API_KEY=
COMPASS_LLM_URL=
COMPASS_LLM_MODEL=

# Live NFC demo (/nfc/intern, /nfc/manager, /nfc/display). Firebase Realtime Database web config.
# These values are public by design; access is enforced by database.rules.json. Never add a service account key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Shared demo session id baked into the NFC card URLs. Lowercase letters, numbers, dashes.
NEXT_PUBLIC_DEMO_SESSION=rbc-judges
# Local testing only: point at the Firebase emulator (npm run emulators), e.g. 127.0.0.1:9000
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=
